# Commonplace runtime
PORT=4173
COMMONPLACE_DATA_DIR=./data

# Intake limits (bounded again by the server)
CAPTURE_TIMEOUT_MS=8000
CAPTURE_MAX_BYTES=8000000
UPLOAD_MAX_BYTES=25000000

# Optional self-hosted Firecrawl. Leave blank to use the local Readability path.
# Example Docker-network URL: http://firecrawl:3002
FIRECRAWL_BASE_URL=
# Set only if your self-hosted Firecrawl instance enables authentication.
FIRECRAWL_API_KEY=

# Optional browser-rendered fallback for JavaScript-heavy public pages.
CAPTURE_BROWSER_FALLBACK=false
PLAYWRIGHT_EXECUTABLE_PATH=

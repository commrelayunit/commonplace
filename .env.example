# Commonplace runtime
PORT=4173
COMMONPLACE_DATA_DIR=./data

# Intake limits (bounded again by the server)
CAPTURE_TIMEOUT_MS=8000
CAPTURE_MAX_BYTES=8000000
UPLOAD_MAX_BYTES=25000000

# Optional self-hosted Firecrawl. Leave blank to use the local Readability path.
# Example Docker-network URL: http://firecrawl:3002
FIRECRAWL_BASE_URL=
# Set only if your self-hosted Firecrawl instance enables authentication.
FIRECRAWL_API_KEY=

# Optional browser-rendered fallback for JavaScript-heavy public pages.
CAPTURE_BROWSER_FALLBACK=false
PLAYWRIGHT_EXECUTABLE_PATH=

# Local dev dependency overlay (compose.dev.yaml) — see scripts/dev-bootstrap.sh
FIRECRAWL_REPO_URL=https://github.com/mendableai/firecrawl.git
FIRECRAWL_REPO_TAG=v2.11.162
FIRECRAWL_CHECKOUT_DIR=.dev/firecrawl
PDF_SERVICE_PORT=8008

# PDF-to-Markdown service (services/pdf-markdown). Leave blank to use the
# lightweight built-in PDF.js text-layer fallback.
PDF_SERVICE_BASE_URL=
# CPU conversion of a real document is slow; 3 minutes is a realistic default.
PDF_SERVICE_TIMEOUT_MS=180000
